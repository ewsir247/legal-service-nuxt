# Copy this file to ".env" for local dev / set the same keys in your hosting
# provider's environment variables for production (e.g. Cloudflare Pages).
# NEVER commit the real .env file — the webhook URL grants full CRM access.

# Required — incoming webhook from Bitrix24 (Приложения → Разработчикам → Входящий вебхук)
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/your_key_here/

# Optional
# BITRIX_ENTITY=lead              # "lead" (default) or "deal"
# BITRIX_ASSIGNED_BY_ID=1         # assign leads to this Bitrix user id
# BITRIX_SOURCE_ID=WEB            # CRM source code
# ALLOWED_ORIGIN=http://localhost:3000

# Public site URL used for canonical/OG tags and JSON-LD
NUXT_PUBLIC_SITE_URL=https://ewsir.space
