# Copy this file to ".env" for local dev / set the same keys in your hosting
# provider's environment variables for production (e.g. Cloudflare Pages).
# NEVER commit the real .env file — the webhook URL grants full CRM access.

# Required — incoming webhook from Bitrix24 (Приложения → Разработчикам → Входящий вебхук)
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/your_key_here/

# Optional
# BITRIX_ENTITY=lead              # "lead" (default) or "deal"
# BITRIX_ASSIGNED_BY_ID=1         # assign leads to this Bitrix user id
# BITRIX_SOURCE_ID=WEB            # CRM source code
# ALLOWED_ORIGIN=https://your-production-domain.example  # defaults to the
#   project's Cloudflare Pages URL if unset — set this once a custom domain
#   is attached. Never set this to "*".

# Public site URL used for canonical/OG tags, JSON-LD and sitemap.xml/robots.txt
NUXT_PUBLIC_SITE_URL=https://legal-service-nuxt.pages.dev

# Optional — 2GIS MapGL API key for the office map on the homepage.
# Get one at platform.2gis.ru (Sign in -> create a MapGL key; a free demo
# key valid for 1 month is available). Without this key the map falls back
# to an OpenStreetMap embed automatically — the site never shows a broken map.
NUXT_PUBLIC_2GIS_API_KEY=

# Optional — Cloudflare Turnstile (bot protection on the callback form).
# Get a free site/secret key pair at https://dash.cloudflare.com/?to=/:account/turnstile
# Without these the form works as before, with only the honeypot field as
# bot protection (no widget is rendered, no server-side check runs).
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=

# Optional — Cloudflare KV namespace binding name used for rate limiting and
# submit idempotency on /api/callback (see wrangler.toml / Pages dashboard ->
# Settings -> Functions -> KV namespace bindings). Bind it as RATE_LIMIT_KV.
# Without this binding, rate limiting and idempotency are skipped (the form
# still works, just without spam protection beyond the honeypot/Turnstile).
# This project does not create the KV namespace itself — create it with
# `wrangler kv namespace create RATE_LIMIT_KV` and bind it in the Pages
# dashboard or wrangler.toml.
